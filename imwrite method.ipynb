   "source": [
    "import cv2\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "3b4cde1e-bead-48e5-8c7a-8919d9666295",
   "metadata": {},
   "outputs": [],
   "source": [
    "img=cv2.imread(\"picture/girl_21.jpg\")\n",
    "img=cv2.resize(img,(330,350))\n",
    "\n",
    "h=np.hstack((img,img))\n",
    "v=np.vstack((h,h))\n",
    "\n",
    "cv2.imwrite(\"picture/girl_2.jpg\",v)\n",
    "\n",
    "cv2.imshow(\"Image\",v)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  },
